{
  "name": "spring-forest-vscode",
  "displayName": "Spring Forest VSCode",
  "description": "Spring Forest and Night Forest color themes for Visual Studio Code",
  "version": "0.0.1",
  "publisher": "spring-forest",
  "repository": {
    "type": "git",
    "url": "https://github.com/zuoio/spring_forest_vscode.git"
  },
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "color-theme",
    "everforest",
    "spring-forest",
    "night-forest"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Spring Forest",
        "uiTheme": "vs",
