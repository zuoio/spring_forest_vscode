    "list.highlightForeground": "#7FBBB3",
    "tree.indentGuidesStroke": "#404C51",
    "activityBar.background": "#111C15",
    "activityBar.foreground": "#D3C6AA",
    "activityBar.inactiveForeground": "#7A8478",
    "activityBar.activeBorder": "#7FBBB3",
    "activityBar.activeBackground": "#17261B",
    "activityBarBadge.background": "#7FBBB3",
    "activityBarBadge.foreground": "#0B120E",
    "sideBar.background": "#0B120E",
    "sideBar.foreground": "#D3C6AA",
    "sideBar.border": "#17261B",
    "sideBarSectionHeader.background": "#111C15",
    "sideBarSectionHeader.foreground": "#D3C6AA",
    "sideBarSectionHeader.border": "#27402E",
    "titleBar.activeBackground": "#111C15",
    "titleBar.activeForeground": "#D3C6AA",
    "titleBar.inactiveBackground": "#111C15",
    "titleBar.inactiveForeground": "#7A8478",
    "titleBar.border": "#27402E",
    "editorGroupHeader.tabsBackground": "#0B120E",
    "editorGroupHeader.noTabsBackground": "#111C15",
    "editorGroup.border": "#27402E",
    "tab.activeBackground": "#0B120E",
    "tab.activeForeground": "#D3C6AA",
    "tab.inactiveBackground": "#111C15",
    "tab.inactiveForeground": "#859289",
    "tab.activeBorderTop": "#7FBBB3",
    "tab.unfocusedActiveBorder": "#7A8478",
    "tab.border": "#27402E",
    "tab.unfocusedActiveForeground": "#9DA9A0",
    "tab.unfocusedInactiveForeground": "#7A8478",
    "panel.background": "#0B120E",
    "panel.border": "#17261B",
    "panelTitle.activeBorder": "#7FBBB3",
    "panelTitle.activeForeground": "#D3C6AA",
    "panelTitle.inactiveForeground": "#859289",
    "statusBar.background": "#111C15",
    "statusBar.foreground": "#D3C6AA",
    "statusBar.border": "#27402E",
    "statusBarItem.hoverBackground": "#27402E",
    "statusBarItem.prominentBackground": "#384B55",
    "statusBarItem.prominentHoverBackground": "#214C61",
    "statusBar.debuggingBackground": "#E69875",
    "statusBar.debuggingForeground": "#0B120E",
    "editor.background": "#0B120E",
    "editor.foreground": "#D3C6AA",
    "editorLineNumber.foreground": "#596763",
    "editorLineNumber.activeForeground": "#D3C6AA",
    "editorCursor.foreground": "#D3C6AA",
    "editor.lineHighlightBackground": "#111C15",
    "editor.lineHighlightBorder": "#17261B",
    "editor.selectionBackground": "#214C61",
    "editor.inactiveSelectionBackground": "#384B55",
    "editor.selectionHighlightBackground": "#384B55",
    "editor.wordHighlightBackground": "#3C4841",
    "editor.wordHighlightStrongBackground": "#45443C",
    "editorWhitespace.foreground": "#576268",
    "editorIndentGuide.background1": "#404C51",
    "editorIndentGuide.activeBackground1": "#3B5360",
    "editorGutter.background": "#0B120E",
    "editorGutter.addedBackground": "#A7C080",
    "editorGutter.deletedBackground": "#E67E80",
    "editorGutter.modifiedBackground": "#DBBC7F",
    "editorCodeLens.foreground": "#7A8478",
    "editorBracketMatch.background": "#3A515D",
    "editorBracketMatch.border": "#7FBBB3",
    "editorOverviewRuler.border": "#27402E",
    "editorOverviewRuler.errorForeground": "#E67E80",
    "editorOverviewRuler.warningForeground": "#E69875",
    "editorOverviewRuler.infoForeground": "#7FBBB3",
    "editorOverviewRuler.addedForeground": "#A7C080",
    "editorOverviewRuler.deletedForeground": "#E67E80",
    "editorOverviewRuler.modifiedForeground": "#DBBC7F",
    "editorError.foreground": "#E67E80",
    "editorWarning.foreground": "#E69875",
    "editorInfo.foreground": "#7FBBB3",
    "editorHint.foreground": "#83C092",
    "editorWidget.background": "#111C15",
    "editorWidget.foreground": "#D3C6AA",
    "editorWidget.border": "#27402E",
    "editorSuggestWidget.background": "#111C15",
    "editorSuggestWidget.border": "#27402E",
    "editorSuggestWidget.foreground": "#D3C6AA",
    "editorSuggestWidget.highlightForeground": "#7FBBB3",
    "editorSuggestWidget.selectedBackground": "#214C61",
    "editorHoverWidget.background": "#111C15",
    "editorHoverWidget.border": "#27402E",
    "peekView.background": "#111C15",
    "peekView.border": "#7FBBB3",
    "peekViewEditor.background": "#0B120E",
    "peekViewEditor.matchHighlightBackground": "#214C61",
    "peekViewResult.background": "#17261B",
    "peekViewResult.selectionBackground": "#214C61",
    "diffEditor.insertedTextBackground": "#445349",
    "diffEditor.removedTextBackground": "#544247",
    "diffEditor.insertedLineBackground": "#3C4841",
    "diffEditor.removedLineBackground": "#493B40",
    "scrollbarSlider.background": "#7A847866",
    "scrollbarSlider.hoverBackground": "#85928988",
    "scrollbarSlider.activeBackground": "#9DA9A0AA",
    "minimap.background": "#111C15",
    "minimap.selectionHighlight": "#214C61",
    "minimap.errorHighlight": "#E67E80",
    "minimap.warningHighlight": "#E69875",
    "gitDecoration.addedResourceForeground": "#A7C080",
    "gitDecoration.modifiedResourceForeground": "#DBBC7F",
    "gitDecoration.deletedResourceForeground": "#E67E80",
    "gitDecoration.untrackedResourceForeground": "#83C092",
    "gitDecoration.conflictingResourceForeground": "#D699B6",
    "terminal.background": "#0B120E",
    "terminal.foreground": "#D3C6AA",
    "terminalCursor.foreground": "#D3C6AA",
    "terminal.ansiBlack": "#475258",
    "terminal.ansiRed": "#E67E80",
    "terminal.ansiGreen": "#A7C080",
    "terminal.ansiYellow": "#DBBC7F",
    "terminal.ansiBlue": "#7FBBB3",
    "terminal.ansiMagenta": "#D699B6",
    "terminal.ansiCyan": "#83C092",
    "terminal.ansiWhite": "#D3C6AA",
    "terminal.ansiBrightBlack": "#475258",
    "terminal.ansiBrightRed": "#E67E80",
    "terminal.ansiBrightGreen": "#A7C080",
    "terminal.ansiBrightYellow": "#DBBC7F",
    "terminal.ansiBrightBlue": "#7FBBB3",
    "terminal.ansiBrightMagenta": "#D699B6",
    "terminal.ansiBrightCyan": "#83C092",
    "terminal.ansiBrightWhite": "#D3C6AA"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {"foreground": "#859289", "fontStyle": "italic"}
    },
    {
      "name": "Documentation comments",
      "scope": ["comment.documentation", "comment.block.documentation", "comment.line.documentation"],
      "settings": {"foreground": "#859289", "fontStyle": "italic"}
    },
    {
      "name": "Invalid and illegal",
      "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
      "settings": {"foreground": "#E67E80", "background": "#544247"}
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage", "storage.modifier", "storage.type.class", "storage.type.function"],
      "settings": {"foreground": "#E67E80"}
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator"],
      "settings": {"foreground": "#E69875"}
    },
    {
      "name": "Types and classes",
      "scope": ["entity.name.type", "entity.other.inherited-class", "support.type", "support.class", "storage.type", "entity.name.type.class", "entity.name.type.interface"],
      "settings": {"foreground": "#DBBC7F"}
    },
    {
      "name": "Functions and methods",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function", "entity.name.function.method"],
      "settings": {"foreground": "#A7C080"}
    },
    {
      "name": "Constants and numbers",
      "scope": ["constant", "constant.language", "support.constant", "constant.character", "variable.language"],
      "settings": {"foreground": "#83C092"}
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float"],
      "settings": {"foreground": "#D699B6"}
    },
    {
      "name": "Variables and properties",
      "scope": ["variable", "support.variable", "variable.other", "variable.object.property", "meta.definition.variable"],
      "settings": {"foreground": "#7FBBB3"}
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.function.parameters"],
      "settings": {"foreground": "#D3C6AA"}
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "string.interpolated"],
      "settings": {"foreground": "#83C092"}
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape", "string.quoted constant.character.escape"],
      "settings": {"foreground": "#DBBC7F"}
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp", "constant.regexp"],
      "settings": {"foreground": "#7FBBB3"}
    },
    {
      "name": "Language labels and decorators",
      "scope": ["entity.name.label", "label", "entity.name.tag.decorator", "meta.decorator"],
      "settings": {"foreground": "#E69875"}
    },
    {
      "name": "HTML and XML tags",
      "scope": ["entity.name.tag", "entity.name.tag.html", "entity.name.tag.xml", "meta.tag", "punctuation.definition.tag"],
      "settings": {"foreground": "#E69875"}
    },
    {
      "name": "HTML and XML attributes",
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.html", "entity.other.attribute-name.xml"],
      "settings": {"foreground": "#83C092", "fontStyle": "italic"}
    },
    {
      "name": "HTML and XML attribute values",
      "scope": ["string.quoted.html", "string.quoted.xml"],
      "settings": {"foreground": "#A7C080"}
    },
    {
      "name": "CSS selectors and properties",
      "scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "meta.selector"],
      "settings": {"foreground": "#E67E80"}
    },
    {
      "name": "CSS property names",
      "scope": ["support.type.property-name", "meta.property-name"],
      "settings": {"foreground": "#E69875"}
    },
    {
      "name": "CSS property values",
      "scope": ["meta.property-value", "support.constant.property-value"],
      "settings": {"foreground": "#83C092"}
    },
    {
      "name": "Markup headings and emphasis",
      "scope": ["markup.heading", "markup.bold", "markup.italic"],
      "settings": {"foreground": "#E67E80"}
    },
    {
      "name": "Markup links",
      "scope": ["markup.underline.link", "meta.link", "string.other.link"],
      "settings": {"foreground": "#7FBBB3", "fontStyle": "underline"}
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "meta.brace.round", "meta.brace.square", "meta.brace.curly"],
      "settings": {"foreground": "#D3C6AA"}
    },
    {
      "name": "Markup quotes and code",
      "scope": ["markup.quote", "markup.raw", "markup.inline.raw", "markup.fenced_code"],
      "settings": {"foreground": "#A7C080"}
    },
    {
      "name": "Diff and deleted text",
      "scope": ["markup.deleted", "markup.strikethrough"],
      "settings": {"foreground": "#E67E80", "background": "#493B40"}
    },
    {
      "name": "Inserted text",
      "scope": ["markup.inserted"],
      "settings": {"foreground": "#A7C080", "background": "#3C4841"}
    }
  ],
  "semanticTokenColors": {
    "comment": {"foreground": "#859289", "italic": true},
    "keyword": "#E67E80",
    "operator": "#E69875",
    "number": "#D699B6",
    "string": "#83C092",
    "regexp": "#7FBBB3",
    "class": "#DBBC7F",
    "interface": "#A7C080",
    "type": "#DBBC7F",
    "typeParameter": "#DBBC7F",
    "enum": "#DBBC7F",
    "enumMember": "#83C092",
    "function": "#A7C080",
    "method": "#A7C080",
    "property": "#7FBBB3",
    "variable": "#7FBBB3",
    "parameter": "#D3C6AA",
    "namespace": "#DBBC7F",
    "decorator": "#D699B6",
    "label": "#E69875",
    "selfKeyword": "#7FBBB3"
  }
}
