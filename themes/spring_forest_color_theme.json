    "button.secondaryHoverBackground": "#F3F9E5",
    "dropdown.background": "#FFFFFA",
    "dropdown.border": "#F3F9E5",
    "dropdown.foreground": "#5C6A72",
    "input.background": "#F9FCF2",
    "input.border": "#F3F9E5",
    "input.foreground": "#5C6A72",
    "input.placeholderForeground": "#A6B0A0",
