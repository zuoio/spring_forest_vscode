    "inputOption.activeForeground": "#5C6A72",
    "badge.background": "#3A94C5",
    "badge.foreground": "#FFFFFA",
    "progressBar.background": "#8DA101",
    "list.activeSelectionBackground": "#F9FCF2",
    "list.activeSelectionForeground": "#5C6A72",
    "list.focusBackground": "#F7FBEE",
    "list.focusForeground": "#5C6A72",
    "list.hoverBackground": "#F9FCF2",
    "list.hoverForeground": "#5C6A72",
    "list.inactiveSelectionBackground": "#F7FBEE",
    "list.inactiveSelectionForeground": "#5C6A72",
    "list.highlightForeground": "#3A94C5",
    "tree.indentGuidesStroke": "#EDEAD5",
    "activityBar.background": "#F9FCF2",
    "activityBar.foreground": "#5C6A72",
    "activityBar.inactiveForeground": "#A6B0A0",
    "activityBar.activeBorder": "#3A94C5",
    "activityBar.activeBackground": "#F7FBEE",
    "activityBarBadge.background": "#3A94C5",
    "activityBarBadge.foreground": "#FFFFFA",
    "sideBar.background": "#FFFFFA",
    "sideBar.foreground": "#5C6A72",
    "sideBar.border": "#F7FBEE",
    "sideBarSectionHeader.background": "#F9FCF2",
    "sideBarSectionHeader.foreground": "#5C6A72",
    "sideBarSectionHeader.border": "#F3F9E5",
    "titleBar.activeBackground": "#F9FCF2",
    "titleBar.activeForeground": "#5C6A72",
    "titleBar.inactiveBackground": "#F9FCF2",
    "titleBar.inactiveForeground": "#A6B0A0",
    "titleBar.border": "#F3F9E5",
    "editorGroupHeader.tabsBackground": "#FFFFFA",
    "editorGroupHeader.noTabsBackground": "#F9FCF2",
    "editorGroup.border": "#F3F9E5",
    "tab.activeBackground": "#FFFFFA",
    "tab.activeForeground": "#5C6A72",
    "tab.inactiveBackground": "#F9FCF2",
    "tab.inactiveForeground": "#939F91",
    "tab.activeBorderTop": "#3A94C5",
    "tab.unfocusedActiveBorder": "#A6B0A0",
    "tab.border": "#F3F9E5",
    "tab.unfocusedActiveForeground": "#829181",
    "tab.unfocusedInactiveForeground": "#A6B0A0",
    "panel.background": "#FFFFFA",
    "panel.border": "#F7FBEE",
    "panelTitle.activeBorder": "#3A94C5",
    "panelTitle.activeForeground": "#5C6A72",
    "panelTitle.inactiveForeground": "#939F91",
    "statusBar.background": "#F9FCF2",
    "statusBar.foreground": "#708089",
    "statusBar.border": "#F3F9E5",
    "statusBarItem.hoverBackground": "#F3F9E5",
    "statusBarItem.prominentBackground": "#ECF5ED",
    "statusBarItem.prominentHoverBackground": "#D5EBF2",
    "statusBar.debuggingBackground": "#DFA000",
    "statusBar.debuggingForeground": "#FFFFFA",
    "editor.background": "#FFFFFA",
    "editor.foreground": "#5C6A72",
    "editorLineNumber.foreground": "#BDC3AF",
    "editorLineNumber.activeForeground": "#5C6A72",
    "editorCursor.foreground": "#5C6A72",
    "editor.lineHighlightBackground": "#F9FCF2",
    "editor.lineHighlightBorder": "#F7FBEE",
    "editor.selectionBackground": "#D5EBF2",
    "editor.inactiveSelectionBackground": "#ECF5ED",
    "editor.selectionHighlightBackground": "#ECF5ED",
    "editor.wordHighlightBackground": "#F3F5D9",
    "editor.wordHighlightStrongBackground": "#FEF2D5",
    "editorWhitespace.foreground": "#576268",
    "editorIndentGuide.background1": "#EDEAD5",
    "editorIndentGuide.activeBackground1": "#E9F0E9",
    "editorGutter.background": "#FFFFFA",
    "editorGutter.addedBackground": "#8DA101",
    "editorGutter.deletedBackground": "#F85552",
    "editorGutter.modifiedBackground": "#DFA000",
    "editorCodeLens.foreground": "#A6B0A0",
    "editorBracketMatch.background": "#E3F3DA",
    "editorBracketMatch.border": "#8DA101",
    "editorOverviewRuler.border": "#F3F9E5",
    "editorOverviewRuler.errorForeground": "#F85552",
    "editorOverviewRuler.warningForeground": "#F57D26",
    "editorOverviewRuler.infoForeground": "#3A94C5",
    "editorOverviewRuler.addedForeground": "#8DA101",
    "editorOverviewRuler.deletedForeground": "#F85552",
    "editorOverviewRuler.modifiedForeground": "#DFA000",
    "editorError.foreground": "#F85552",
    "editorWarning.foreground": "#F57D26",
    "editorInfo.foreground": "#3A94C5",
    "editorHint.foreground": "#35A77C",
    "editorWidget.background": "#F9FCF2",
    "editorWidget.foreground": "#5C6A72",
    "editorWidget.border": "#F3F9E5",
    "editorSuggestWidget.background": "#F9FCF2",
    "editorSuggestWidget.border": "#F3F9E5",
    "editorSuggestWidget.foreground": "#5C6A72",
    "editorSuggestWidget.highlightForeground": "#3A94C5",
    "editorSuggestWidget.selectedBackground": "#D5EBF2",
    "editorHoverWidget.background": "#F9FCF2",
    "editorHoverWidget.border": "#F3F9E5",
    "peekView.background": "#F9FCF2",
    "peekView.border": "#3A94C5",
    "peekViewEditor.background": "#FFFFFA",
    "peekViewEditor.matchHighlightBackground": "#D5EBF2",
    "peekViewResult.background": "#F7FBEE",
    "peekViewResult.selectionBackground": "#D5EBF2",
    "diffEditor.insertedTextBackground": "#F0F1D2",
    "diffEditor.removedTextBackground": "#FBE3DA",
    "diffEditor.insertedLineBackground": "#F3F5D9",
    "diffEditor.removedLineBackground": "#FFE7DE",
    "scrollbarSlider.background": "#A6B0A066",
    "scrollbarSlider.hoverBackground": "#82918188",
    "scrollbarSlider.activeBackground": "#708089AA",
    "minimap.background": "#F9FCF2",
    "minimap.selectionHighlight": "#D5EBF2",
    "minimap.errorHighlight": "#F85552",
    "minimap.warningHighlight": "#F57D26",
    "gitDecoration.addedResourceForeground": "#8DA101",
    "gitDecoration.modifiedResourceForeground": "#DFA000",
    "gitDecoration.deletedResourceForeground": "#F85552",
    "gitDecoration.untrackedResourceForeground": "#35A77C",
    "gitDecoration.conflictingResourceForeground": "#DF69BA",
    "terminal.background": "#FFFFFA",
    "terminal.foreground": "#5C6A72",
    "terminalCursor.foreground": "#5C6A72",
    "terminal.ansiBlack": "#829181",
    "terminal.ansiRed": "#F85552",
    "terminal.ansiGreen": "#8DA101",
    "terminal.ansiYellow": "#DFA000",
    "terminal.ansiBlue": "#3A94C5",
    "terminal.ansiMagenta": "#DF69BA",
    "terminal.ansiCyan": "#35A77C",
    "terminal.ansiWhite": "#5C6A72",
    "terminal.ansiBrightBlack": "#939F91",
    "terminal.ansiBrightRed": "#F85552",
    "terminal.ansiBrightGreen": "#8DA101",
    "terminal.ansiBrightYellow": "#DFA000",
    "terminal.ansiBrightBlue": "#3A94C5",
    "terminal.ansiBrightMagenta": "#DF69BA",
    "terminal.ansiBrightCyan": "#35A77C",
    "terminal.ansiBrightWhite": "#FFFFFA"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {"foreground": "#939F91", "fontStyle": "italic"}
    },
    {
      "name": "Documentation comments",
      "scope": ["comment.documentation", "comment.block.documentation", "comment.line.documentation"],
      "settings": {"foreground": "#939F91", "fontStyle": "italic"}
    },
    {
      "name": "Invalid and illegal",
      "scope": ["invalid", "invalid.illegal", "invalid.deprecated"],
      "settings": {"foreground": "#F85552", "background": "#FFE7DE"}
    },
    {
      "name": "Keywords",
      "scope": ["keyword", "storage", "storage.modifier", "storage.type.class", "storage.type.function"],
      "settings": {"foreground": "#F85552"}
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "punctuation.accessor", "punctuation.separator"],
      "settings": {"foreground": "#F57D26"}
    },
    {
      "name": "Types and classes",
      "scope": ["entity.name.type", "entity.other.inherited-class", "support.type", "support.class", "storage.type", "entity.name.type.class", "entity.name.type.interface"],
      "settings": {"foreground": "#DFA000"}
    },
    {
      "name": "Functions and methods",
      "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function", "entity.name.function.method"],
      "settings": {"foreground": "#8DA101"}
    },
    {
      "name": "Constants and numbers",
      "scope": ["constant", "constant.language", "support.constant", "constant.character", "variable.language"],
      "settings": {"foreground": "#35A77C"}
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric", "constant.numeric.integer", "constant.numeric.float"],
      "settings": {"foreground": "#DF69BA"}
    },
    {
      "name": "Variables and properties",
      "scope": ["variable", "support.variable", "variable.other", "variable.object.property", "meta.definition.variable"],
      "settings": {"foreground": "#3A94C5"}
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.function.parameters"],
      "settings": {"foreground": "#5C6A72"}
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "string.interpolated"],
      "settings": {"foreground": "#35A77C"}
    },
    {
      "name": "String escapes",
      "scope": ["constant.character.escape", "string.quoted constant.character.escape"],
      "settings": {"foreground": "#DFA000"}
    },
    {
      "name": "Regular expressions",
      "scope": ["string.regexp", "constant.regexp"],
      "settings": {"foreground": "#3A94C5"}
    },
    {
      "name": "Language labels and decorators",
      "scope": ["entity.name.label", "label", "entity.name.tag.decorator", "meta.decorator"],
      "settings": {"foreground": "#F57D26"}
    },
    {
      "name": "HTML and XML tags",
      "scope": ["entity.name.tag", "entity.name.tag.html", "entity.name.tag.xml", "meta.tag", "punctuation.definition.tag"],
      "settings": {"foreground": "#F57D26"}
    },
    {
      "name": "HTML and XML attributes",
      "scope": ["entity.other.attribute-name", "entity.other.attribute-name.html", "entity.other.attribute-name.xml"],
      "settings": {"foreground": "#35A77C", "fontStyle": "italic"}
    },
    {
      "name": "HTML and XML attribute values",
      "scope": ["string.quoted.html", "string.quoted.xml"],
      "settings": {"foreground": "#8DA101"}
    },
    {
      "name": "CSS selectors and properties",
      "scope": ["entity.name.tag.css", "entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "meta.selector"],
      "settings": {"foreground": "#F85552"}
    },
    {
      "name": "CSS property names",
      "scope": ["support.type.property-name", "meta.property-name"],
      "settings": {"foreground": "#F57D26"}
    },
    {
      "name": "CSS property values",
      "scope": ["meta.property-value", "support.constant.property-value"],
      "settings": {"foreground": "#35A77C"}
    },
    {
      "name": "Markup headings and emphasis",
      "scope": ["markup.heading", "markup.bold", "markup.italic"],
      "settings": {"foreground": "#F85552"}
    },
    {
      "name": "Markup links",
      "scope": ["markup.underline.link", "meta.link", "string.other.link"],
      "settings": {"foreground": "#3A94C5", "fontStyle": "underline"}
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "meta.brace.round", "meta.brace.square", "meta.brace.curly"],
      "settings": {"foreground": "#5C6A72"}
    },
    {
      "name": "Markup quotes and code",
      "scope": ["markup.quote", "markup.raw", "markup.inline.raw", "markup.fenced_code"],
      "settings": {"foreground": "#8DA101"}
    },
    {
      "name": "Diff and deleted text",
      "scope": ["markup.deleted", "markup.strikethrough"],
      "settings": {"foreground": "#F85552", "background": "#FFE7DE"}
    },
    {
      "name": "Inserted text",
      "scope": ["markup.inserted"],
      "settings": {"foreground": "#8DA101", "background": "#F3F5D9"}
    }
  ],
  "semanticTokenColors": {
    "comment": {"foreground": "#939F91", "italic": true},
    "keyword": "#F85552",
    "operator": "#F57D26",
    "number": "#DF69BA",
    "string": "#35A77C",
    "regexp": "#3A94C5",
    "class": "#DFA000",
    "interface": "#8DA101",
    "type": "#DFA000",
    "typeParameter": "#DFA000",
    "enum": "#DFA000",
    "enumMember": "#35A77C",
    "function": "#8DA101",
    "method": "#8DA101",
    "property": "#3A94C5",
    "variable": "#3A94C5",
    "parameter": "#5C6A72",
    "namespace": "#DFA000",
    "decorator": "#DF69BA",
    "label": "#F57D26",
    "selfKeyword": "#3A94C5"
  }
}
